# =================================================================
# Pixora 2.0 Docker & VPS Production Environment Configuration
# =================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env

# Security
SECRET_KEY=generate_a_secure_random_64_char_key_here
SECURITY_PASSWORD_SALT=generate_a_secure_salt_here
SESSION_COOKIE_SECURE=True

# Database (PostgreSQL)
POSTGRES_USER=pixora
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_DB=pixora
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Ports
WEB_PORT=5000
GATEWAY_PORT=8000

# Telemetry Streams
TELEMETRY_STREAM_KEY=pixora:telemetry
TELEMETRY_GROUP_NAME=pixora_telemetry_group
TELEMETRY_DLQ_KEY=pixora:telemetry:dlq

# Cloud Storage (Cloudflare R2 / AWS S3 for CDN Game Bundles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
R2_ENDPOINT_URL=
S3_BUCKET_NAME=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CDN_BASE_URL=https://cdn.pixora.com


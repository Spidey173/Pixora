# =================================================================
# Pixora 2.0 Docker & VPS Production Environment Configuration
# =================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env

# Security
SECRET_KEY=CHANGE_ME
SECURITY_PASSWORD_SALT=CHANGE_ME
SESSION_COOKIE_SECURE=True

# Database (PostgreSQL)
POSTGRES_USER=pixora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pixora
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Ports
WEB_PORT=5000
GATEWAY_PORT=8000

# Telemetry Streams
TELEMETRY_STREAM_KEY=pixora:telemetry
TELEMETRY_GROUP_NAME=pixora_telemetry_group
TELEMETRY_DLQ_KEY=pixora:telemetry:dlq

# Cloud Storage (Cloudflare R2 / AWS S3 for CDN Game Bundles)
CLOUDFLARE_R2_ENABLED=False
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
R2_ENDPOINT_URL=CHANGE_ME
S3_BUCKET_NAME=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
CDN_BASE_URL=https://cdn.pixora.com

# Pixora Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application Settings
FLASK_ENV=development
SECRET_KEY=CHANGE_ME

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database URI (SQLite by default, or postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///game_data.db

# Admin Account Seeding (Optional on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Security & Session Configuration
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
RATELIMIT_DEFAULT=200/hour
RATELIMIT_AUTH=20/minute

# Cloudflare R2 / S3 Edge Storage (If enabled)
CLOUDFLARE_R2_ENABLED=False
CLOUDFLARE_R2_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_ME
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_ME
CLOUDFLARE_R2_BUCKET_NAME=pixora-games
CLOUDFLARE_R2_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://CHANGE_ME.r2.dev

# Redis & Telemetry
REDIS_URL=redis://127.0.0.1:6379/0
TELEMETRY_STREAM_KEY=pixora:telemetry

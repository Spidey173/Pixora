# Pixora Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_random_key_here_change_in_production

# Server Settings
HOST=0.0.0.0
PORT=5000

# Database URI (SQLite by default, or postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///game_data.db

# Security & Session Configuration
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
RATELIMIT_DEFAULT=200/hour
RATELIMIT_AUTH=20/minute
